---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../lib/seo';
---

<BaseLayout
  title="About AH Design | Web Design & Marketing Team"
  description="Meet AH Design: a creative digital team building user-centred websites, running marketing campaigns and helping businesses in Bulgaria and Europe grow."
  schema={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About us', path: '/about-us' },
    ]),
  ]}
  htmlClass="no-js vlt-is--about-us vlt-is--header-fullscreen vlt-is--footer-style-1 vlt-is--footer-fixed"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>
  <!--Site overlay-->
  <div class="vlt-site-overlay"></div>
  <!--Main-->
  <main class="vlt-main">
    <!--Page content-->
    <div class="vlt-page-content">
      <!--Page title-->
      <div class="vlt-page-title vlt-page-title--style-4">
        <div class="container">
          <div class="row">
            <div class="col-md-7 offset-md-1">
              <h1 class="vlt-page-title__title">We create digital products</h1>
            </div>
            <div class="col-md-3">
              <div
                class="vlt-page-title__phantom-title lax"
                data-lax-translate-x="0 0, vw (vw*0.5)"
                data-lax-opacity="1 1, 250 0"
                data-lax-anchor=".vlt-page-title"
              >
                About
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="content"></div>
      <div class="vlt-gap-120"></div>

      <!--========================= About us ==========================-->
      <section class="jarallax has-gray-color" style="background-color:black;">
        <!-- <img class="jarallax-img"
					src="static/img/careers-single-background.png" alt="" loading="lazy"> -->
        <div class="container">
          <div class="row">
            <div class="col-md-10 offset-md-1">
              <div class="vlt-stretch-block to-left vlt-devide-section">
                <div class="position-relative d-flex align-items-end justify-content-end">
                  <!--Content slider-->
                  <div
                    class="vlt-content-slider"
                    data-navigation-anchor=".vlt-careers-single-slider-anchor"
                    data-gap=""
                    data-loop=""
                    data-speed=""
                    data-autoplay=""
                    data-autoplay-speed=""
                    data-slides-centered=""
                    data-slide-settings="{}"
                    data-free-mode=""
                    data-slider-offset=""
                    data-mousewheel=""
                  >
                    <div class="swiper-container">
                      <div class="swiper-wrapper">
                        <div class="swiper-slide">
                          <img
                            src="/static/img/about/4.jpg"
                            alt="AH Design's co-founders reviewing work together at a laptop"
                            width="1400"
                            height="692"
                            loading="lazy"
                          />
                        </div>
                        <div class="swiper-slide">
                          <img
                            src="/static/img/about/2.jpg"
                            alt="AH Design co-founder working on a laptop"
                            width="1400"
                            height="692"
                            loading="lazy"
                          />
                        </div>
                        <div class="swiper-slide">
                          <img
                            src="/static/img/about/3.jpg"
                            alt="AH Design co-founder reviewing work on a tablet"
                            width="1400"
                            height="692"
                            loading="lazy"
                          />
                        </div>
                        <div class="swiper-slide">
                          <img
                            src="/static/img/about/1.jpg"
                            alt="AH Design's co-founders reviewing work together on a laptop and tablet"
                            width="1400"
                            height="692"
                            loading="lazy"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                  <!--Slider controls-->
                  <div
                    class="vlt-slider-controls vlt-slider-controls--style-3 vlt-careers-single-slider-anchor ah-slider-controls position-absolute b-0 r-0"
                  >
                    <div class="vlt-swiper-button-prev ah-slider-btn">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
                        ><path
                          d="M9 2 4 7l5 5"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path></svg
                      >
                      Prev
                    </div><span class="ah-slider-sep"></span>
                    <div class="vlt-swiper-button-next ah-slider-btn">
                      Next
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
                        ><path
                          d="M5 2l5 5-5 5"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path></svg
                      >
                    </div>
                  </div>
                </div>
              </div>
              <div class="vlt-gap-120"></div>
            </div>
            <!-- who we are -->
            <div class="vlt-gap-120"></div>
            <div class="container">
              <div class="row">
                <div class="col-md-11 offset-md-1">
                  <!--Animated block-->
                  <div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
                    <span class="vlt-display-1 has-primary-color">ABOUT</span>
                  </div>
                  <div class="vlt-gap-30"></div>
                </div>
                <div class="col-md-4 offset-md-1">
                  <!--Animated block-->
                  <div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
                    <!--Section title-->
                    <div class="vlt-section-title vlt-section-title--style-1">
                      <h2 class="vlt-section-title__title" style="color: #bbb;">OUR TEAM</h2>
                      <h4 class="vlt-section-title__title" style="color: #bbb;">Who we are:</h4>
                    </div>
                  </div>
                  <div class="vlt-gap-40--sm"></div>
                </div>
                <div class="col-md-7">
                  <!--Animated block-->
                  <div class="vlt-animated-block" data-aos="fade" data-aos-delay="100">
                    <p class="fz-3 text-justify" style="text-indent: 40px;">
                      AH Design is led by its two co-founders, Afif and Hamid. Afif is the designer
                      and front-end developer who shapes how your brand looks and feels online. She
                      leads SEO and GEO/AEO (AI search optimization) so you get found. Hamid handles
                      the back end, DevOps and automation, so your website runs fast and secure, and
                      the bookings, forms, chatbots and repetitive tasks run on their own. Both of
                      us plan and manage your Google and Meta ad campaigns. We are also backed by a
                      trusted network of specialists when a project needs more hands. You&rsquo;ll
                      always work directly with the two of us.
                    </p>
                    <div class="vlt-gap-30"></div>
                    <p class="fz-3 text-justify" style="text-indent: 40px;">
                      We start by helping you get clear on your brand: who you are, who you serve,
                      and how you want to be seen online. From there, we guide you in building a
                      consistent digital presence across your website, search results, social
                      channels and ads. Then we build it: high-converting websites and online
                      stores, visibility on search engines and AI search tools like ChatGPT, smart
                      automations and ChatBots that save you time, and Google and Meta campaigns
                      that bring in qualified customers.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div class="vlt-gap-50"></div>

            <div class="col-md-11 offset-md-1">
              <!--Animated block-->
              <div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
                <div class="has-light-gray-color" style="opacity: .16;">
                  <!--Mission-->
                  <div class="vlt-stroke-text vlt-stroke-text--lg">01</div>
                </div>
                <h5 class="has-white-color negative-top-offset-lg">Our mission</h5>
                <div class="vlt-gap-40"></div>
                <p class="text-justify">
                  Our mission is to deliver creative, reliable and cost-effective digital solutions
                  that create real value for our clients. Whatever the project, we follow a set of
                  principles in delivering our mission:

                  <ul class="vlt-styled-list list-about">
                    <li>
                      We take the time to fully understand your needs and goals before we start
                    </li>
                    <li>
                      We choose the right technology to solve the real problem, not the trendiest
                      one
                    </li>
                    <li>
                      We look for opportunities that create lasting value and sustainable growth
                    </li>
                    <li>We help you adapt quickly as your market and your customers change</li>
                    <li>
                      We keep you flexible and competitive with modern, future-ready solutions
                    </li>
                    <li>We stand by you long after launch, as a partner in your success</li>
                  </ul>
                </p>
              </div>
              <div class="vlt-gap-60--sm"></div>
            </div>
            <div class="vlt-gap-400"></div>

            <div class="col-md-11 offset-md-1">
              <!--Animated block-->
              <div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
                <div class="has-light-gray-color" style="opacity: .16;">
                  <!--Vision-->
                  <div class="vlt-stroke-text vlt-stroke-text--lg">02</div>
                </div>
                <h5 class="has-white-color negative-top-offset-lg">Our vision</h5>
                <div class="vlt-gap-40"></div>
                <p class="text-justify">
                  Our vision is focused on constant innovation and growth. At the core of our
                  company is the ambition to deliver work of the highest quality. Above all, we want
                  AH Design to stand for integrity, transparency, commitment, and lasting
                  partnerships, wherever in the world our clients are.
                </p>
              </div>
              <div class="vlt-gap-60--sm"></div>
            </div>
          </div>
        </div>
        <div class="vlt-gap-120"></div>
      </section>

      <!--=============== our skills ===============-->
      <section class="position-relative">
        <div class="vlt-gap-120"></div>
        <div class="container">
          <div class="row">
            <div class="col-md-10 offset-md-1">
              <div class="text-center">
                <!--Animated block-->
                <div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
                  <!--Section title-->
                  <div class="vlt-section-title vlt-section-title--style-1">
                    <span class="vlt-section-title__subtitle"
                      >Three parts. One integrated system.</span
                    >
                    <h2 class="vlt-section-title__title ah-gradient-title">How We Drive Growth</h2>
                    <p class="vlt-section-title__text">
                      A website alone won&rsquo;t scale a business, and ads without conversion are
                      just wasted spend. We align infrastructure, organic reach, and paid
                      acquisition into a unified engine where every piece supports the next.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="vlt-gap-80"></div>
          <div class="row">
            <div class="col-md-12">
              <!--Animated block-->
              <div class="vlt-animated-block" data-aos="fade" data-aos-delay="100">
                <div class="ah-growth-grid">
                  <div class="ah-growth-card">
                    <span class="ah-growth-card__icon" aria-hidden="true">
                      <img
                        src="/static/img/icon/web.png"
                        alt=""
                        width="36"
                        height="36"
                        loading="lazy"
                      />
                    </span>
                    <div class="ah-growth-card__eyebrow">THE FOUNDATION (WEB)</div>
                    <h3 class="ah-growth-card__title">Core Digital Infrastructure</h3>
                    <ul class="ah-growth-card__list">
                      <li>High-converting websites &amp; online stores</li>
                      <li>Automated booking, forms &amp; 24/7 chatbots</li>
                      <li>Frictionless digital checkout flows</li>
                      <li>Custom business management platforms</li>
                    </ul>
                  </div>
                  <div class="ah-growth-card">
                    <span class="ah-growth-card__icon" aria-hidden="true">
                      <img
                        src="/static/img/icon/ads.png"
                        alt=""
                        width="36"
                        height="36"
                        loading="lazy"
                      />
                    </span>
                    <div class="ah-growth-card__eyebrow">THE FUEL (SEO, GEO &amp; AEO)</div>
                    <h3 class="ah-growth-card__title">Search &amp; AI Discovery</h3>
                    <ul class="ah-growth-card__list">
                      <li>Search engine visibility (Google &amp; Bing)</li>
                      <li>Optimization for AI search answers</li>
                      <li>Local maps optimized for nearby clients</li>
                      <li>Reliable organic inquiries that grow</li>
                    </ul>
                  </div>
                  <div class="ah-growth-card">
                    <span class="ah-growth-card__icon" aria-hidden="true">
                      <img
                        src="/static/img/icon/marketing.png"
                        alt=""
                        width="36"
                        height="36"
                        loading="lazy"
                      />
                    </span>
                    <div class="ah-growth-card__eyebrow">THE ACCELERATOR (GOOGLE &amp; META)</div>
                    <h3 class="ah-growth-card__title">Targeted Paid Campaigns</h3>
                    <ul class="ah-growth-card__list">
                      <li>Targeted campaigns on Google &amp; Meta</li>
                      <li>Fast, steady flow of qualified traffic</li>
                      <li>Continuous ad testing to lower client costs</li>
                      <li>Clear, measurable return on ad spend</li>
                    </ul>
                  </div>
                </div>
                <div class="vlt-gap-30"></div>
                <div class="ah-growth-outcome">
                  <div class="ah-growth-outcome__eyebrow">THE OUTCOME</div>
                  <h3 class="ah-growth-outcome__title">Unified Scaling</h3>
                  <p class="ah-growth-outcome__desc">
                    Instead of managing three separate freelancers who blame each other when leads
                    drop, you get one integrated growth partner accountable for the entire pipeline.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="vlt-gap-120"></div>
      </section>

      <!--================ video ==================-->
      <section class="jarallax text-center">
        <video class="video-show2" autoplay muted loop>
          <source src="/static/img/video/about-us.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
        <div class="vlt-gap-100"></div>
      </section>

      <!--============== Let's work ================-->
      <section class="has-primary-background-color has-white-color">
        <div class="vlt-gap-100"></div>
        <div class="container">
          <div class="text-center">
            <!--Animated block-->
            <div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
              <!--Stroke text-->
              <div class="vlt-stroke-text vlt-stroke-text--lg">
                <a href="/order/" target="_self">Let's start</a>
              </div>
            </div>
          </div>
        </div>
        <div class="vlt-gap-100"></div>
      </section>
    </div>
  </main>
</BaseLayout>
