---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema, serviceSchema } from '../lib/seo';

const description =
  'Fricta helps businesses and institutions eliminate inefficiencies using AI systems, workflow optimization, automation, and operational intelligence.';
---

<BaseLayout
  title="Fricta: Operational Intelligence & AI Workflows | AH Design"
  description={description}
  schema={[
    serviceSchema({
      name: 'Fricta operational intelligence',
      description,
      path: '/fricta',
      serviceType: 'Business process automation',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Fricta', path: '/fricta' },
    ]),
  ]}
  htmlClass="no-js vlt-is--header-fullscreen vlt-is--footer-style-1 vlt-is--footer-fixed"
>
  <main class="vlt-main">
    <div class="fricta-page">
      <header class="fricta-header">
        <div class="fricta-logo">FRICTA</div>
        <nav class="fricta-nav">
          <a href="#solutions">Solutions</a>
          <a href="#process">Process</a>
          <a href="#case-studies">Case Studies</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <section class="fricta-hero">
        <h1>We Identify Operational Chaos — Then Remove It.</h1>
        <p>
          Fricta helps businesses and institutions eliminate inefficiencies using AI systems,
          workflow optimization, automation, and operational intelligence.
        </p>

        <div class="fricta-buttons">
          <a href="#contact" class="fricta-btn fricta-primary">Book Discovery Call</a>
          <a href="#process" class="fricta-btn fricta-secondary">See Our Approach</a>
        </div>
      </section>

      <section class="fricta-section problem-section-wrapper ah-spt">
        <h2>
          Most businesses don't have a people problem.<br />They have a systems problem.
        </h2>

        <div class="problem-list">
          <div class="problem-item">
            <span class="problem-number">01</span>
            <div class="problem-body">
              <h3>Operational Bottlenecks</h3>
              <p>Teams wasting hours on repetitive tasks, approvals, and fragmented workflows.</p>
            </div>
          </div>

          <div class="problem-item">
            <span class="problem-number">02</span>
            <div class="problem-body">
              <h3>Invisible Inefficiencies</h3>
              <p>Managers often see symptoms — not the root causes creating operational friction.</p>
            </div>
          </div>

          <div class="problem-item">
            <span class="problem-number">03</span>
            <div class="problem-body">
              <h3>Lack of Visibility</h3>
              <p>No centralized operational intelligence, reporting clarity, or process transparency.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="solutions" class="fricta-section problem-section-wrapper">
        <h2>What We Do</h2>

        <div class="fricta-grid grid-4">
          <div class="fricta-card">
            <h3>Operational Audits</h3>
            <p>We map workflows, identify friction points, and expose hidden inefficiencies.</p>
          </div>

          <div class="fricta-card">
            <h3>AI Workflow Systems</h3>
            <p>Smart assistants, automation layers, ticket intelligence, and decision-support systems.</p>
          </div>

          <div class="fricta-card">
            <h3>Process Optimization</h3>
            <p>We redesign operational flows to reduce complexity, delays, and wasted effort.</p>
          </div>

          <div class="fricta-card">
            <h3>Custom Internal Tools</h3>
            <p>Dashboards, queue systems, analytics, reporting layers, and workflow management platforms.</p>
          </div>
        </div>
      </section>

      <section id="process" class="fricta-section">
        <h2>How We Work</h2>

        <div class="timeline">
          <div class="timeline-step">
            <div class="timeline-dot">01</div>
            <h3>Discover</h3>
            <p>We analyze workflows, communication patterns, and operational pain points.</p>
          </div>

          <div class="timeline-step">
            <div class="timeline-dot">02</div>
            <h3>Diagnose</h3>
            <p>We identify root causes, bottlenecks, and unnecessary friction.</p>
          </div>

          <div class="timeline-step">
            <div class="timeline-dot">03</div>
            <h3>Build</h3>
            <p>We design systems that simplify operations and increase visibility.</p>
          </div>

          <div class="timeline-step">
            <div class="timeline-dot">04</div>
            <h3>Optimize</h3>
            <p>Continuous iteration, analytics, and operational refinement.</p>
          </div>
        </div>
      </section>

      <section id="contact" class="fricta-cta">
        <h2>Broken systems cost more than people realize.</h2>
        <p style="color:#b5b5b5; margin-bottom:30px;">
          Let's identify the friction slowing your business down.
        </p>

        <a href="/contact" class="fricta-btn fricta-primary">Start With an Operational Audit</a>
      </section>

    </div>
  </main>
</BaseLayout>
