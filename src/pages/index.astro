      </section>

      <!--=================== Pricing / engagements ===================-->
      <section class="ah-pricing">
        <div class="ah-pricing__inner">
          <div class="ah-pricing__head">
            <p class="ah-pricing__label" aria-hidden="true">ENGAGEMENTS</p>
            <p class="ah-pricing__intro">
              We work two ways: a monthly partnership or a fixed project. Tell us your goals and we
              will scope it.
            </p>
          </div>

          <h2 class="ah-visually-hidden">Engagement options</h2>

          <div class="ah-pricing__grid">
            <div class="ah-price-card ah-price-card--dark">
              <div class="ah-price-card__head">
                <h3>MONTHLY PARTNERSHIP</h3>
                <span class="ah-price-card__badge"><span></span>Limited availability</span>
              </div>
              <div class="ah-price-card__price">Starting from 150 €/month</div>
              <p class="ah-price-card__desc">
                For businesses that want one partner to build and grow their whole digital presence,
                step by step.
              </p>
              <div class="ah-price-card__features">
                {
                  PARTNERSHIP_FEATURES.map((f) => (
                    <div class="ah-price-feature">
                      <svg
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="rgba(255,255,255,0.6)"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <>
                          <circle cx="12" cy="12" r="9" />
                          <path d="M8.5 12 l2.4 2.4 L16 9" />
                        </>
                      </svg>
                      <span>{f}</span>
                    </div>
                  ))
                }
              </div>
              <a class="ah-price-card__cta ah-ripple" href="/call/"
                ><span class="ah-ripple__fx" aria-hidden="true"></span>Start a Partnership<span
                  class="ah-price-card__cta-icon"
                  ><svg width="14" height="14" viewBox="0 0 17 17" fill="none" aria-hidden="true"
                    ><path
                      d="M4 13 L13 4 M6 4 H13 V11"
                      stroke="#ffffff"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path></svg
                  ></span
                ></a
              >
            </div>

            <div class="ah-price-card ah-price-card--teal">
              <div class="ah-price-card__head">
                <h3>FIXED PROJECT</h3>
                <span class="ah-price-card__badge"><span></span>Open for new projects</span>
              </div>
              <div class="ah-price-card__price">Starting from 500 €</div>
              <p class="ah-price-card__desc">
                For businesses that need a website, app or automation built with a clear scope and
                timeline.
              </p>
              <div class="ah-price-card__features">
                {
                  PROJECT_FEATURES.map((f) => (
                    <div class="ah-price-feature">
                      <svg
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="rgba(32,31,66,0.5)"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <>
                          <circle cx="12" cy="12" r="9" />
                          <path d="M8.5 12 l2.4 2.4 L16 9" />
                        </>
                      </svg>
                      <span>{f}</span>
                    </div>
                  ))
                }
              </div>
              <a class="ah-price-card__cta ah-ripple" href="/price/"
                ><span class="ah-ripple__fx" aria-hidden="true"></span>Explore all detailed pricing
                plans<span class="ah-price-card__cta-icon"
                  ><svg width="14" height="14" viewBox="0 0 17 17" fill="none" aria-hidden="true"
                    ><path
                      d="M4 13 L13 4 M6 4 H13 V11"
                      stroke="#ffffff"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path></svg
                  ></span
                ></a
              >
            </div>
          </div>
        </div>
      </section>

      <!--================ projects =================-->
      <section class="bg-project">
        <div class="vlt-gap-120"></div>
        <div class="container">
          <div class="row align-items-center">
            <div class="col-md-8 offset-md-1">
              <div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
                <div class="vlt-section-title vlt-section-title--style-1">
                  <h2 class="vlt-section-title__title" style="color: white;">Latest Projects</h2>
                </div>
              </div>
              <div class="vlt-gap-30--sm"></div>
            </div>
            <div class="col-md-3">
              <div class="text-md-right has-black-color">
                <div class="vlt-animated-block" data-aos="fade" data-aos-delay="100">
                  <a class="ah-project-cta ah-ripple" href="/projects/" target="_self">
                    <span class="ah-ripple__fx" aria-hidden="true"></span>
                    See all projects
                    <span class="ah-project-cta__icon">
                      <svg width="14" height="14" viewBox="0 0 17 17" fill="none" aria-hidden="true"
                        ><path
                          d="M4 13 L13 4 M6 4 H13 V11"
                          stroke="#ffffff"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path></svg
                      >
                    </span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="vlt-gap-120"></div>
      </section>

      <!-- =============== Blog ==================== -->
      <section>
        <div class="vlt-gap-150"></div>
        <div class="container">
          <div class="text-center">
            <div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
              <div class="vlt-section-title vlt-section-title--style-2">
                <h2 class="vlt-section-title__title">Blog</h2>
              </div>
            </div>
          </div>
          <div class="vlt-gap-100"></div>
          <div class="row">
            <div class="col-md-10 offset-md-1">
              <div class="vlt-animated-block" data-aos="fade" data-aos-delay="100">
                <div
                  class="vlt-isotope-grid"
                  data-columns="1"
                  data-layout="masonry"
                  data-x-gap="0|0"
                  data-y-gap="0|0"
                  data-controls="#vlt-filter-blog-03"
                  data-load-more-selector="#vlt-load-more-blog-03"
                >
                  <div class="grid-sizer"></div>
                  {
                    recentPosts.map((post) => (
                      <div class=" grid-item filter-design">
                        <article class="vlt-post vlt-post--style-5">
                          <div class="vlt-post__content">
                            <div class="vlt-post-date">
                              <span>{post.published_date_day}</span>
                              <span>{post.published_date_month}</span>
                            </div>
                            <h3
                              class="vlt-post-title has-cursor"
                              data-tooltip-image={post.thumbnail}
                            >
                              <a href={`/post/${post.slug}/`}>{post.title}</a>
                            </h3>
                            <div class="vlt-post-category">{post.category_title}</div>
                          </div>
                        </article>
                      </div>
                    ))
                  }
                </div>
              </div>
              <div class="vlt-gap-80"></div>
              <div class="text-center has-black-color">
                <div class="vlt-animated-block" data-aos="fade" data-aos-delay="200">
                  <a
                    class="ah-more__btn ah-more__btn--outline ah-ripple"
                    href="/blog/"
                    target="_self"
                  >
                    <span class="ah-ripple__fx" aria-hidden="true"></span>
                    See all Articles
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      ><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"
                      ></polyline></svg
                    >
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="vlt-gap-150"></div>
      </section>

      <!--=================== Tell us what you need ===================-->
      <section class="ah-need" id="need-cta">
        <div class="ah-need__inner">
          <h2 class="ah-need__title">Tell us what you need.</h2>

          <div class="ah-need__bar">
            <span class="ah-need__prefix">I need a</span>
            <div class="ah-need__chips" id="ahNeedChips">
              <span class="ah-need__chips-hint">(pick from list below or type)</span>
            </div>
            <a class="ah-need__next ah-ripple" href="/order/" id="ahNeedNext">
              <span class="ah-ripple__fx" aria-hidden="true"></span>
              Next
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"
                ></polyline></svg
              >
            </a>
          </div>

          <div class="ah-need__grid" id="ahNeedGrid">
            {
              NEED_SERVICES.map((name) => (
                <button type="button" class="ah-need__service" data-need={name}>
                  <span class="ah-need__service-label">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="rgb(91, 205, 190)"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="9 10 4 15 9 20" />
                      <path d="M20 4 v7 a4 4 0 0 1 -4 4 H4" />
                    </svg>
                    <span>{name}</span>
                  </span>
                  <svg
                    class="ah-need__service-plus"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="rgba(32,31,66,0.35)"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <>
                      <line x1="12" y1="5" x2="12" y2="19" />
                      <line x1="5" y1="12" x2="19" y2="12" />
                    </>
                  </svg>
                </button>
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </main>

  <Fragment slot="js">
    <script src="/static/scripts/index2.js" is:inline></script>
  </Fragment>
</BaseLayout>
