---
import BaseLayout from '../layouts/BaseLayout.astro';
import { versioned } from '../lib/asset-version';
import { getCollection } from 'astro:content';
import { serviceSchema } from '../lib/seo';

// canonical_slug posts are duplicates of another entry — see blog.astro.
const recentPosts = (await getCollection('blog'))
  .filter((post) => !post.data.canonical_slug)
  .sort((a, b) => b.data.published_date.localeCompare(a.data.published_date))
  .slice(0, 3)
  .map((p) => p.data);

// Carried over from the previous homepage (home-v1.astro) so the structured
// data doesn't regress with the redesign — these are the business's real
// services regardless of which page design is linking to them.
const services = [
  serviceSchema({
    name: 'Website design and development',
    description:
      'Responsive websites, e-commerce stores and custom web applications built around user-centred design.',
    path: '/web-development',
    serviceType: 'Web design',
  }),
  serviceSchema({
    name: 'Digital marketing and advertising',
    description:
      'SEO, paid advertising campaigns and audio, video and event production that put your business in front of buyers.',
    path: '/ads-service',
    serviceType: 'Digital marketing',
  }),
  serviceSchema({
    name: 'Business development and automation',
    description:
      'Systemised growth plans, workflow automation and AI assistants that remove manual work from your operations.',
    path: '/services',
    serviceType: 'Business consulting',
  }),
];

// The homepage. The previous design lives on at /home-v1/ (noindex), kept
// for reference — see src/pages/home-v1.astro.
//
// Navigation is BaseLayout's own fixed fullscreen header/menu, same as every
// other page — it always paints above <main> (vlt-main.min.css pins .vlt-main
// to z-index: 20, the header to z-index: 30), so a second fixed nav inside
// the page content would render underneath it and be unreachable.

const SERVICE_CARDS = [
  { icon: '/static/img/icon/webapp.png', alt: 'Websites that convert', title: 'Custom Websites' },
  {
    icon: '/static/img/icon/marketing-icon.png',
    alt: 'Marketing that reaches',
    title: 'Digital Marketing',
  },
  {
    icon: '/static/img/icon/automation-icon.png',
    alt: 'Smart automation',
    title: 'Smart Automation',
  },
  {
    icon: '/static/img/icon/seo-geo-icon.png',
    alt: 'SEO/GEO and analytics',
    title: 'Business Scaling',
  },
];

const ABOUT_STATS = [
  { value: '7+', label: 'Years of experience', variant: 'a' },
  { value: '120+', label: 'Projects delivered', variant: 'b' },
];

const ABOUT_ITEMS = [
  { label: 'Web platforms:', text: 'High-end websites built as infrastructure' },
  {
    label: 'Applications:',
    text: 'Custom tools and SaaS products that replace manual work',
  },
  {
    label: 'Integrations:',
    text: 'Your CRM, ERP, invoicing and marketing tools working as one',
  },
  { label: 'AI agents:', text: 'Multi-hour tasks handled in minutes' },
  { label: 'Workflow automation:', text: 'Manual steps replaced by processes' },
  { label: 'Marketing & SEO/GEO:', text: 'Ads and search built for AI-era discovery' },
];

const FLOW_STEPS = [
  {
    step: 'DISCOVER',
    desc: 'We map your business, customers, tools and bottlenecks, so we know what to build, automate and market.',
    pct: '25%',
    pctClass: 'pct-25',
  },
  {
    step: 'DESIGN',
    desc: 'We shape your brand, then plan the website, customer journey and workflows.',
    pct: '50%',
    pctClass: 'pct-50',
    swatch: true,
  },
  {
    step: 'BUILD',
    desc: 'We build the site, connect your tools, and set up automations and tracking.',
    pct: '75%',
    pctClass: 'pct-75',
    img: '/static/img/icon/blocks.png',
  },
  {
    step: 'LAUNCH & GROW',
    desc: 'We launch, run your ads and SEO/GEO, measure results and keep improving.',
    pct: '100%',
    pctClass: 'pct-100',
    img: '/static/img/icon/lunching.png',
  },
];

// Real client testimonials — same source of truth as the current homepage's
// slider (src/pages/index.astro), not placeholder quotes.
const TESTIMONIALS = [
  {
    name: 'Toni P. Lyubenova',
    role: 'Кадърѣ Медия / CEO',
    avatar: '/static/img/kmedia.png',
    quote:
      'When we first saw our website, we instantly knew it will make us stand out from all the other video production companies. AH knew exactly what we wanted and how to make it a reality.',
  },
  {
    name: 'Dr. Nuri',
    role: 'Nurident / CEO',
    avatar: '/static/img/nurident.png',
    quote:
      'As our company embarked on a significant digital transformation within our marketing, we approached Hamid and Afif to help manage the shift. We have seen a significant change in our online presence and conversion rates.',
  },
  {
    name: 'Anastasia Dehtiarova',
    role: 'Ana Dht / CEO',
    avatar: '/static/img/ana.png',
    quote:
      "I love working with Afif and Hamid — they are highly skilled, knowledgeable and resourceful professionals. If you need a great and fast service, I can't recommend them enough.",
  },
  {
    name: 'Mr. Qafari',
    role: 'Nikkaran / CEO',
    avatar: '/static/img/nikkaran.png',
    quote:
      'Highly recommend AHdesign as a web developer and designer. From the initial brief to completion they were supportive, attentive, and always receptive to feedback.',
  },
  {
    name: 'Dr. Nuri',
    role: 'BasalFix / CEO',
    avatar: '/static/img/logo.png',
    quote:
      "I can't say enough about my experience working with AHdesign. Everything they said they would do, they have done, and delivered on time.",
  },
  {
    name: 'Mr. Kohkan',
    role: 'ZVB Co / CEO',
    avatar: '/static/img/zvb.png',
    quote:
      "We worked with AH Design on several parts of our digital presence, including our website, outreach campaign platform, and email templates. The team was responsive, understood our requirements quickly, and delivered solutions that were both practical and well-designed. What we appreciated most was that they didn't just focus on how things looked; they also considered how the website and outreach process would actually work for our business. Communication was smooth throughout, and the final result gave us a much more professional foundation for reaching potential clients. Happy with the collaboration and would definitely recommend AH Design to businesses looking to improve their digital presence and outreach.",
  },
  {
    name: 'Laura',
    role: 'Stadtführung / CEO',
    avatar: '/static/img/stadtfuhrung.png',
    quote:
      'Working with AHdesign was a great pleasure. Afife is kind, creative and efficient. All of my ideas were turned into an amazing website with every detail crafted beautifully.',
  },
  {
    name: 'Hadi',
    role: 'GulvTømrer / CEO',
    avatar: '/static/img/gulvtomrer.png',
    quote:
      "Working with AHdesign was a great experience from start to finish. I needed a clean, fast, and mobile-first website, and they delivered exactly that. What stood out most was their practical guidance throughout the process; they didn't just build a site, they were with me every step of the way as I built my brand. The final site looks great on every device. Highly recommended if you want a team that actually listens and guides you through every step.",
  },
];

const MARQUEE_ITEMS = [
  { label: 'Web development', icon: 'globe' },
  { label: 'eCommerce', icon: 'cart' },
  { label: 'Application development', icon: 'grid', accent: true },
  { label: 'Website Migration', icon: 'migrate' },
  { label: 'Branding', icon: 'palette' },
  { label: 'Google Ads', icon: 'megaphone' },
  { label: 'Meta Ads', icon: 'chat' },
  { label: 'Business Scaling', icon: 'target', accent: true },
  { label: 'Automation', icon: 'compass' },
];
// Rendered twice back-to-back so the CSS marquee animation can loop seamlessly.
const MARQUEE_LOOP = [...MARQUEE_ITEMS, ...MARQUEE_ITEMS];

const PARTNERSHIP_FEATURES = [
  'A clear brand and digital presence',
  'Your website and online identity',
  'SEO/GEO to get you found',
  'Automation, ads and ongoing improvement',
  'Flexible capacity, fast response, direct line',
];
const PROJECT_FEATURES = [
  'Brand identity',
  'Web design and development',
  'SEO/GEO-ready build',
  'Clear scope, price and timeline',
  'Launch and handover',
];

const NEED_SERVICES = [
  'Website',
  'Google Ads',
  'Meta Ads',
  'Applications (web & mobile)',
  'SEO/GEO',
  'eCommerce',
  'Branding',
  'Website Migration',
  'Business Scaling',
  'Automation',
  'Maintenance',
  'Second Opinion',
];
---

<BaseLayout
  title="AH Design — Your Digital Ecosystem Partner"
  description="Most agencies build pages. AH Design builds the websites, marketing, automation and analytics your business runs on."
  schema={services}
  htmlClass="no-js vlt-is--header-fullscreen vlt-is--footer-style-1 vlt-is--footer-fixed"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={versioned('/static/css/index2.css')} />
  </Fragment>

  <div class="vlt-site-overlay"></div>

  <main class="vlt-main">
    <div class="ah-page">
      <!--=================== Hero (scroll morph) ===================-->
      <section class="ah-hero-track" id="ahMorphTrack">
        <div class="ah-hero-sticky" id="ahMorphSticky">
          <div class="ah-hero-grid" id="ahMorphGrid">
            {
              SERVICE_CARDS.map((card, i) => (
                <div class={`ah-side-card ah-side-card--${'abcd'[i]}`} data-side>
                  <img src={card.icon} alt={card.alt} width="180" height="180" loading="lazy" />
                  <p class="ah-side-card__label">{card.title}</p>
                </div>
              )).slice(0, 2)
            }

            <div class="ah-hero-cell" id="ahMorphCell">
              <div class="ah-hero-card" id="ahMorphCard">
                <video
                  class="ah-hero-video"
                  id="ahMorphVideo"
                  autoplay
                  muted
                  loop
                  playsinline
                  src="/static/img/video/purple-desert.mp4"></video>
                <div class="ah-hero-overlay"></div>
                <div class="ah-hero-solid"></div>
                <div class="ah-hero-text" id="ahMorphText">
                  <div class="ah-hero-eyebrow">WEB • MARKETING • AUTOMATION</div>
                  <h1>Most agencies build pages. <br />We build your digital peace of mind.</h1>
                  <p>
                    A flawless digital ecosystem built to scale your business while you focus on
                    what matters.
                  </p>
                  <a class="ah-hero-strategy ah-ripple" href="/order/">
                    <span class="ah-ripple__fx" aria-hidden="true"></span>
                    Get Your Custom Strategy
                    <span class="ah-hero-strategy__icon">
                      <svg width="11" height="11" viewBox="0 0 17 17" fill="none" aria-hidden="true"
                        ><path
                          d="M4 13 L13 4 M6 4 H13 V11"
                          stroke="#ffffff"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path></svg
                      >
                    </span>
                  </a>
                </div>
                <div class="ah-hero-cardtext" id="ahMorphCardtext">
                  <span class="ah-hero-services" id="ahMorphServices">Services</span>
                  <h2 id="ahMorphPartner">One partner for your entire digital ecosystem.</h2>
                </div>
              </div>
            </div>

            {
              SERVICE_CARDS.map((card, i) => (
                <div class={`ah-side-card ah-side-card--${'abcd'[i]}`} data-side>
                  <img src={card.icon} alt={card.alt} width="180" height="180" loading="lazy" />
                  <p class="ah-side-card__label">{card.title}</p>
                </div>
              )).slice(2, 4)
            }
          </div>
        </div>
      </section>

      <!--=================== About ===================-->
      <!-- ah-about-track reserves the section's natural height in normal
           flow; index2.js pins the ah-about section itself (fixed/absolute)
           inside it, the same JS-driven trick the hero uses — see the
           comment on .ah-about-track in index2.css for why plain CSS
           `position: sticky` doesn't work here. -->
      <div class="ah-about-track" id="ahAboutTrack">
        <section class="ah-about" id="ahAboutSticky">
          <div class="ah-about__panel">
            <div class="ah-about__grid">
              <div class="ah-about__left">
                <span class="ah-eyebrow">What We Do</span>
                <h2 class="ah-about__title">We build systems your business runs on.</h2>
                <p class="ah-about__lead">
                  AH Design combines strategy, creativity, and technology to help businesses grow
                  online. From high-performing websites to marketing, automation, and analytics,
                  every project is handled with clarity and precision.
                </p>
                <div class="ah-stats">
                  {
                    ABOUT_STATS.map((stat) => (
                      <div class="ah-stat">
                        <span class="ah-stat__value">{stat.value}</span>
                        <span class={`ah-stat__tag ah-stat__tag--${stat.variant}`}>
                          {stat.label}
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>

              <div class="ah-about__right">
                {
                  ABOUT_ITEMS.map((item) => (
                    <div class="ah-about__pill">
                      <span class="ah-about__pill-label">{item.label}</span>{' '}
                      <span class="ah-about__pill-text">{item.text}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </section>
      </div>

      <!--=================== Flow / process ===================-->
      <section class="ah-flow">
        <div class="ah-flow__inner">
          <div class="ah-flow__head">
            <p class="ah-flow__label" aria-hidden="true">FLOW</p>
            <p class="ah-flow__intro">How we turn your goals into a system that runs and grows.</p>
          </div>

          <div class="ah-eyebrow-row">
            <span class="ah-eyebrow">Process — <b>4</b> Steps</span>
          </div>

          <h2 class="ah-visually-hidden">Our four-step process</h2>

          <div class="ah-flow__grid">
            {
              FLOW_STEPS.map((s) => (
                <div class="ah-flow__col">
                  {s.img && (
                    <img
                      class="ah-flow__visual-img"
                      src={s.img}
                      alt=""
                      width="100"
                      height="100"
                      loading="lazy"
                    />
                  )}
                  {s.swatch && <div class="ah-flow__swatch" />}
                  <h3 class="ah-flow__step">{s.step}</h3>
                  <p class="ah-flow__desc">{s.desc}</p>
                  <div class="ah-flow__pct">{s.pct}</div>
                  <div class="ah-flow__bar">
                    <div class={`ah-flow__bar-fill ah-flow__bar-fill--${s.pctClass}`} />
                  </div>
                </div>
              ))
            }
            <div class="ah-flow__connector" aria-hidden="true"></div>
          </div>
        </div>
      </section>

      <!--=================== Contact CTA ===================-->
      <section class="ah-contact">
        <div class="ah-contact__inner">
          <div class="ah-contact__grid">
            <div>
              <h2 class="ah-contact__title">Let&rsquo;s map <br />your next move.</h2>
            </div>
            <div class="ah-contact__right">
              <p class="ah-contact__copy">
                In a free 30-minute call, we&rsquo;ll look at your brand, website and digital
                presence, and show you what to focus on first.
              </p>
              <div class="ah-contact__cta-wrap ah-ripple">
                <span class="ah-ripple__fx" aria-hidden="true"></span>
                <a class="ah-contact__cta" href="/call/">
                  <span>
                    Book a Discovery Call<br />
                    <span class="ah-contact__cta-sub">no strings attached</span>
                  </span>
                  <span class="ah-contact__cta-icon">
                    <svg
                      width="40%"
                      height="40%"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      ><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"
                      ></polyline></svg
                    >
                  </span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!--=================== Testimonials ===================-->
      <section class="ah-testimonials">
        <div class="ah-testimonials__inner">
          <span class="ah-eyebrow ah-eyebrow--light">Testimonials</span>

          <div class="ah-testimonials__head">
            <h2 class="ah-testimonials__title">Brands that love <br />working with us</h2>
            <div class="ah-testi-arrows">
              <button class="ah-testi-arrow" id="ahTestiPrev" aria-label="Previous testimonial">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  ><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="11 18 5 12 11 6"
                  ></polyline></svg
                >
              </button>
              <button class="ah-testi-arrow" id="ahTestiNext" aria-label="Next testimonial">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  ><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"
                  ></polyline></svg
                >
              </button>
            </div>
          </div>

          <div class="ah-testi-grid" id="ahTestiGrid">
            {
              TESTIMONIALS.slice(0, 3).map((t, i) => (
                <div
                  class={`ah-testi-card ah-testi-card--${i === 1 ? 'mid' : 'side'}`}
                  data-testi-pos={i}
                >
                  <div class="ah-testi-icon" data-testi-icon>
                    {i === 0 && (
                      <svg
                        width="34"
                        height="34"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M12 0 C12.8 6.5 17.5 11.2 24 12 C17.5 12.8 12.8 17.5 12 24 C11.2 17.5 6.5 12.8 0 12 C6.5 11.2 11.2 6.5 12 0 Z" />
                      </svg>
                    )}
                    {i === 1 && (
                      <svg
                        width="34"
                        height="34"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3.4"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="8" />
                      </svg>
                    )}
                    {i === 2 && (
                      <svg
                        width="34"
                        height="34"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M12 2 C10.5 7 7 10.5 2 12 C7 13.5 10.5 17 12 22 C13.5 17 17 13.5 22 12 C17 10.5 13.5 7 12 2 Z" />
                        <circle cx="12" cy="12" r="2.2" fill="#f4f0ff" />
                      </svg>
                    )}
                  </div>
                  <p class="ah-testi-quote" data-testi-quote>
                    <>
                      <span data-testi-text>{t.quote}</span>
                      <button class="ah-testi-more" data-testi-more type="button">
                        See more
                      </button>
                    </>
                  </p>
                  <div class="ah-testi-meta">
                    <img
                      class="ah-testi-avatar"
                      data-testi-avatar
                      src={t.avatar}
                      alt={`${t.name} logo`}
                      width="52"
                      height="52"
                      loading="lazy"
                    />
                    <div>
                      <div class="ah-testi-name" data-testi-name>
                        {t.name}
                      </div>
                      <div class="ah-testi-role" data-testi-role>
                        {t.role}
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <script
            type="application/json"
            id="ahTestimonialsData"
            set:html={JSON.stringify(TESTIMONIALS)}
          />
        </div>
      </section>

      <!--=================== More about + marquee ===================-->
      <section class="ah-more">
        <div class="ah-more__inner">
          <div class="ah-more__grid">
            <div>
              <span class="ah-eyebrow">More About Us</span>
            </div>
            <div>
              <h2 class="ah-more__title">
                Strategy, design, marketing, and engineering happen in one room, so decisions stay
                fast and quality stays consistent from first idea to launch.
              </h2>
              <div class="ah-more__actions">
                <a class="ah-more__btn ah-ripple" href="/about-us/">
                  <span class="ah-ripple__fx" aria-hidden="true"></span>
                  Get to Know Us
                  <span class="ah-more__btn-icon">
                    <svg width="14" height="14" viewBox="0 0 17 17" fill="none" aria-hidden="true"
                      ><path
                        d="M4 13 L13 4 M6 4 H13 V11"
                        stroke="#ffffff"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path></svg
                    >
                  </span>
                </a>
                <a class="ah-more__btn ah-more__btn--outline ah-ripple" href="/projects/">
                  <span class="ah-ripple__fx" aria-hidden="true"></span>
                  How We Did It
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    ><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"
                    ></polyline></svg
                  >
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="ah-marquee">
          <div class="ah-marquee__track">
            {
              MARQUEE_LOOP.map((item) => (
                <div class={`ah-marquee__item ${item.accent ? 'ah-marquee__item--accent' : ''}`}>
                  {item.icon === 'globe' && (
                    <svg
                      width="26"
                      height="26"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="9" />
                      <ellipse cx="12" cy="12" rx="4" ry="9" />
                      <line x1="3" y1="12" x2="21" y2="12" />
                      <line x1="4.5" y1="7" x2="19.5" y2="7" />
                      <line x1="4.5" y1="17" x2="19.5" y2="17" />
                    </svg>
                  )}
                  {item.icon === 'cart' && (
                    <svg
                      width="26"
                      height="26"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="9" cy="20" r="1.4" />
                      <circle cx="18" cy="20" r="1.4" />
                      <path d="M2 3 H5 L7 15 H19 L21 6 H6" />
                    </svg>
                  )}
                  {item.icon === 'grid' && (
                    <svg
                      width="26"
                      height="26"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      aria-hidden="true"
                    >
                      <rect x="4" y="3" width="16" height="18" rx="2" />
                      <line x1="4" y1="8" x2="20" y2="8" />
                      <line x1="4" y1="13" x2="20" y2="13" />
                      <line x1="9" y1="8" x2="9" y2="21" />
                      <line x1="15" y1="8" x2="15" y2="21" />
                    </svg>
                  )}
                  {item.icon === 'spark' && (
                    <svg
                      width="26"
                      height="26"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M12 1 L15 9 L23 12 L15 15 L12 23 L9 15 L1 12 L9 9 Z" />
                    </svg>
                  )}
                  {item.icon === 'palette' && (
                    <svg
                      width="26"
                      height="26"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path
                        d="M12 3 C7 3 3 7 3 12 C3 16 6 19 10 19 C10.8 19 11.3 18.3 11.1 17.5
                           C10.9 16.9 10.7 16.3 11.3 15.7 C11.7 15.3 12.3 15.3 12.8 15.6
                           C13.6 16.1 14.5 16.4 15.4 16.1 C18.1 15.3 21 13.3 21 10
                           C21 6.1 17 3 12 3 Z"
                      />
                      <circle cx="7.5" cy="10.5" r="1.1" fill="currentColor" stroke="none" />
                      <circle cx="11" cy="7" r="1.1" fill="currentColor" stroke="none" />
                      <circle cx="15.5" cy="8" r="1.1" fill="currentColor" stroke="none" />
                      <circle cx="17" cy="11.5" r="1.1" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                  {item.icon === 'megaphone' && (
                    <svg
                      width="26"
                      height="26"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3 10 V14 L7 15 V9 Z" />
                      <path d="M7 9 L17 5 V19 L7 15" />
                      <path d="M5.5 15 L6.5 20 H9 L8 15.3" />
                      <path d="M17 9.5 C18.5 10 18.5 14 17 14.5" />
                    </svg>
                  )}
                  {item.icon === 'chat' && (
                    <svg
                      width="26"
                      height="26"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 5 H16 V14 H9 L5 17.5 V14 H4 Z" />
                      <path d="M9 14 C9 16.8 11.4 19 14.3 19 H15.5 L19 21.5 V18.6 C19.6 18.1 20 17.3 20 16.4 V11 C20 9 18.3 7.3 16.2 7.3" />
                    </svg>
                  )}
                  {item.icon === 'migrate' && (
                    <svg
                      width="26"
                      height="26"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="2" y="3" width="8" height="8" rx="1.2" />
