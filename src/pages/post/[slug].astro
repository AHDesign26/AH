---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, absoluteUrl, articleSchema, breadcrumbSchema, isoDate } from '../../lib/seo';
import { imageDims } from '../../lib/image-dims';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// canonical_slug posts are duplicates of another entry (their own canonical
// tag points elsewhere), so they're excluded from counts and listings here
// — same as blog.astro's grid and schema.
const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.canonical_slug)
  .sort((a, b) => b.data.published_date.localeCompare(a.data.published_date));
const allCategories = await getCollection('categories');
const categoriesWithCount = allCategories.map((cat) => ({
  slug: cat.data.slug,
  title: cat.data.title,
  count: allPosts.filter((p) => p.data.category_slug === cat.data.slug).length,
}));
const allCategoriesCount = allPosts.length;

const author = post.data.author_slug ? await getEntry('authors', post.data.author_slug) : null;

const recentPosts = allPosts.slice(0, 4);

// Hero image, author photo and each sidebar thumbnail are a different size
// per post/author — read the real dimensions so <img width height> can be
// set below and the page doesn't jump as they load in.
const heroDims = await imageDims(post.data.hero_image);
const authorPhotoDims = author ? await imageDims(author.data.photo) : null;
const recentPostsDims = new Map(
  await Promise.all(
    recentPosts.map(async (rp) => [rp.data.slug, await imageDims(rp.data.thumbnail)] as const),
  ),
);

const canonicalPath = `/post/${post.data.canonical_slug ?? post.data.slug}`;
const url = absoluteUrl(canonicalPath);
const published = isoDate(post.data.published_date);
// meta_desc is truncated at import for a few posts; brief is the fuller text.
const description = (post.data.meta_desc || post.data.brief)
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 300);
const shareImage = post.data.hero_image ?? post.data.thumbnail ?? SITE.ogImage;
---

<BaseLayout
  title={`${post.data.meta_title} | ${SITE.name}`}
  description={description}
  image={shareImage}
  ogType="article"
  canonicalPath={canonicalPath}
  schema={[
    articleSchema({
      url,
      headline: post.data.title,
      description,
      datePublished: published,
      image: post.data.hero_image,
      authorName: author?.data.name ?? null,
      authorPath: author ? `/author/${author.data.slug}` : null,
      section: post.data.category_title,
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog' },
      { name: post.data.title, path: canonicalPath },
    ]),
  ]}
  htmlClass="no-js vlt-is--contact-01 vlt-is--header-fullscreen vlt-is--footer-style-1 vlt-is--footer-fixed"
>
  <Fragment slot="head">
    {published && <meta property="article:published_time" content={published} />}
    {
      post.data.category_title && (
        <meta property="article:section" content={post.data.category_title} />
      )
    }
    {author && <meta property="article:author" content={author.data.name} />}
  </Fragment>
  <div class="vlt-site-overlay"></div>
  <main class="vlt-main">
    <section style="padding-top: 150px;">
      <div class="container">
        <div class="vlt-post-media-title vlt-post-media-title--style-1 jarallax">
          {
            post.data.hero_image && (
              <img
                class="jarallax-img"
                src={post.data.hero_image}
                alt={post.data.hero_alt || post.data.title}
                width={heroDims?.width}
                height={heroDims?.height}
                fetchpriority="high"
              />
            )
          }
        </div>
      </div>
    </section>

    <div class="vlt-page-content vlt-page-content--padding">
      <section>
        <div class="container">
          <div class="row">
            <div class="col-lg-8">
              <article class="vlt-single-post vlt-single-post--style-4">
                <header class="vlt-single-post__header">
                  <h1 class="vlt-post-title ah-gradient-title">{post.data.title}</h1>
                  {post.data.subtitle && <h3 style="padding-top: 20px;">{post.data.subtitle}</h3>}
                  <div class="vlt-post-meta">
                    <span>{post.data.published_date_raw}</span>
                    <span>{post.data.category_title}</span>
                  </div>
                </header>
                <div class="vlt-single-post__content">
                  <Fragment set:html={post.data.body_html} />
                  <div class="vlt-gap-70"></div>
                </div>

                {
                  author && (
                    <div class="vlt-about-author">
                      <div class="vlt-about-author__avatar">
                        <a href={`/author/${author.data.id}/`} aria-label={author.data.name}>
                          {author.data.photo ? (
                            <img
                              src={author.data.photo}
                              alt={author.data.photo_alt}
                              width={authorPhotoDims?.width}
                              height={authorPhotoDims?.height}
                              loading="lazy"
                            />
                          ) : (
                            <span class="vlt-about-author__initial" aria-hidden="true">
                              {author.data.name.charAt(0)}
                            </span>
                          )}
                        </a>
                      </div>
                      <div class="vlt-about-author__content">
                        <span class="vlt-about-author__label">Written by</span>
                        <h5 class="vlt-about-author__title">{author.data.name}</h5>
                        {author.data.bio_html && (
                          <p class="vlt-about-author__text">
                            <Fragment set:html={author.data.bio_html} />
                          </p>
                        )}
                        <a
                          class="vlt-btn ah-btn vlt-about-author__cta"
                          href={`/author/${author.data.id}/`}
                          target="_self"
                        >
                          Author posts
                          <i class="ah-btn-icon">
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 17 17"
                              fill="none"
                              aria-hidden="true"
                            >
                              <path
                                d="M4 13 L13 4 M6 4 H13 V11"
                                stroke="#ffffff"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </i>
                        </a>
                      </div>
                    </div>
                  )
                }
              </article>
            </div>

            <div class="col-lg-4">
              <div class="vlt-sidebar vlt-sidebar--right">
                <div class="vlt-widget vlt-widget--search">
                  <form class="vlt-search-form">
                    <label class="ah-visually-hidden" for="postSearch">Search</label>
                    <input type="text" id="postSearch" placeholder="Search" />
                    <button>
                      <i class="icon-search-2"></i>
                    </button>
                  </form>
                </div>

                <div class="vlt-widget vlt-widget--categories">
                  <h5 class="vlt-widget__title">Categories</h5>
                  <ul>
                    <li><a href="/blog/">All Categories <span>({allCategoriesCount})</span></a></li>
                    {
                      categoriesWithCount.map((cat) => (
                        <li>
                          <a href={`/category/${cat.slug}/`}>
                            {cat.title} <span>( {cat.count} )</span>
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>

                <div class="vlt-widget vlt-widget--recent-posts">
                  <h5 class="vlt-widget__title">Recent Posts</h5>
                  {
                    recentPosts.map((rp) => (
                      <div class="vlt-widget-post">
                        <div class="vlt-widget-post__thumbnail">
                          <a href={`/post/${rp.data.slug}/`} aria-label={rp.data.title}>
                            {rp.data.thumbnail && (
                              <img
                                src={rp.data.thumbnail}
                                alt=""
                                width={recentPostsDims.get(rp.data.slug)?.width}
                                height={recentPostsDims.get(rp.data.slug)?.height}
                                loading="lazy"
                              />
                            )}
                          </a>
                        </div>
                        <div class="vlt-widget-post__content">
                          <span>
                            {rp.data.published_date_raw} / {rp.data.category_title}
                          </span>
                          <h5>
                            <a class="ah-gradient-title" href={`/post/${rp.data.slug}/`}>
                              {rp.data.title}
                            </a>
                          </h5>
                        </div>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
