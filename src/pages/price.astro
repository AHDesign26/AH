---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GROWTH_PACKAGES, WEBSITE_PACKAGES, type Package } from '../lib/llms';
import { absoluteUrl, breadcrumbSchema, faqSchema } from '../lib/seo';

const PRICE_FAQ = [
  {
    question: 'What determines the final price of a website?',
    answer:
      'The price is largely determined by the size of your website — the number of pages, the style, and the features you choose. Every package starts from a fixed, published price; the exact quote depends on scope.',
  },
  {
    question: 'Do I own the website once it is built?',
    answer:
      "Yes. You own everything we build — the code, the content and the accounts. There's no monthly lock-in and no forced retainer to keep using what you paid for.",
  },
  {
    question: 'Are there recurring fees after the one-off packages?',
    answer:
      'No — the one-off website packages are a fixed price with no monthly platform fee from us. The monthly growth packages are a separate, optional option for ongoing marketing and development work.',
  },
  {
    question: 'How is pricing calculated for ad management?',
    answer:
      'Ad management is a flat rate of 10% of your total monthly advertising spend. Individual quotes are available for unique requirements.',
  },
  {
    question: 'What do the monthly growth packages include?',
    answer:
      'The monthly packages (starting from 150 €/month) are for businesses that want an ongoing partner for their whole digital presence — design, development, marketing and support — rather than a single one-off project.',
  },
];

/** Prices are "starting from", so they publish minPrice rather than price. */
function offer(pkg: Package, monthly: boolean) {
  return {
    '@type': 'Offer',
    name: pkg.name,
    description: pkg.desc,
    url: absoluteUrl('/price'),
    category: monthly ? 'Business growth retainer' : 'Website design and development',
    ...(pkg.amount === null
      ? { availability: 'https://schema.org/InStock' }
      : {
          priceSpecification: {
            '@type': 'PriceSpecification',
            minPrice: pkg.amount,
            priceCurrency: 'EUR',
            ...(monthly ? { billingDuration: 1, billingIncrement: 1, unitText: 'MON' } : {}),
          },
        }),
  };
}

const offerCatalog = {
  '@type': 'OfferCatalog',
  name: 'AH Design packages',
  url: absoluteUrl('/price'),
  itemListElement: [
    {
      '@type': 'OfferCatalog',
      name: 'Digital presence and visibility (one-off website packages)',
      itemListElement: WEBSITE_PACKAGES.map((pkg) => offer(pkg, false)),
    },
    {
      '@type': 'OfferCatalog',
      name: 'Business scaling (monthly growth packages)',
      itemListElement: GROWTH_PACKAGES.map((pkg) => offer(pkg, true)),
    },
  ],
};
