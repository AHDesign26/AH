---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Prices — AH-design"
  htmlClass="no-js vlt-is--careers-single vlt-is--header-fullscreen vlt-is--footer-style-1 vlt-is--footer-fixed"
>
<style>
  /* Glassmorphism for the pricing cards. They sit on the black webdesign
     section, so we override `bgc-black` (which custom.css remaps to a light
     #f5f5f5) with a translucent white + backdrop-blur frost. All in-card
     text classes (text-dark-l1 etc.) are dark by default and would disappear
     on the new frosted bg, so we flip them to light tones too. */
  .vlt-pricing-card {
    background-color: rgb(255 255 255 / 24%) !important;
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    backdrop-filter: blur(16px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
    color: #f1f5f9;
    transition: transform 250ms ease, box-shadow 250ms ease,
      background-color 250ms ease;
  }
  .vlt-pricing-card:hover {
    background-color: rgb(255 255 255 / 32%) !important;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
    transform: translateY(-3px);
  }
  .vlt-pricing-card h4 { color: #ffffff; }
  .vlt-pricing-card .text-secondary-d1,
  .vlt-pricing-card .text-secondary-d2 { color: #e2e8f0 !important; }
  .vlt-pricing-card .text-dark-l1 { color: #f1f5f9 !important; }
  /* Override low-contrast inline gray on the price amount spans. */
  .vlt-pricing-card span[style*="#918f8f"] { color: #ffffff !important; }
</style>
<!--Site overlay-->
	<div class="vlt-site-overlay"></div>
	<!--Main-->
	<main class="vlt-main">
		<!--Page content-->
		<div class="vlt-page-content">
			<div class="vlt-page-title vlt-page-title--style-4">
				<div class="container">
					<div class="row">
						<div class="col-md-7 offset-md-1">
							<h1 class="vlt-page-title__title">We prioritize quality
							</h1>
						</div>
						<div class="col-md-3">
							<div class="vlt-page-title__phantom-title lax" data-lax-translate-x="0 0, vw (vw*0.5)"
								data-lax-opacity="1 1, 250 0" data-lax-anchor=".vlt-page-title">
								Prices
							</div>
						</div>
					</div>
				</div>
			</div>
			<div id="content"></div>


			<!--=========== intro ===========-->
			<section>
				<div class="vlt-gap-100"></div>
				<div class="container">
					<div class="row">
						<div class="col-md-11 offset-md-1">
							<!--Animated block-->
							<div class="vlt-animated-block" data-aos="fade" data-aos-delay="100">
								<p class="fz-3 text-justify">
									We offer different price packages depending on our customers' needs. 
									Several factors such as size, style, and functionality features influence the price of the web desiign, advertisement, and business development packages.

								</p>
							</div>

						</div>

						<div class="vlt-gap-120"></div>
						<div class="col-md-11 offset-md-1">
							<!--Animated block-->
							<div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
								<!--Section title-->
								<div class="vlt-section-title vlt-section-title--style-1">
									<h3 class="vlt-section-title__title">Price is what you pay. Value is what you get.
									</h3>

								</div>
							</div>
							<div class="vlt-gap-40--sm"></div>
						</div>
						<div class="col-md-11 offset-md-1">
							<!--Animated block-->
							<div class="vlt-animated-block" data-aos="fade" data-aos-delay="0"><span
									class="vlt-display-1 has-primary-color">— Warren Buffett</span>
							</div>
							<div class="vlt-gap-30"></div>
						</div>
					</div>
				</div>
				<div class="vlt-gap-120"></div>
			</section>


			<!--================ webdesign package ================== -->
			<section
				class="jarallax has-gray-color"
				style="background-color: black; background-image: url('/static/img/fricta/bg-frica.png'); background-size: cover; background-position: center; background-repeat: no-repeat;"
			>
				<div class="container">
					<div class="row">
						<div class="col-md-10 offset-md-1">
							<div class="vlt-stretch-block to-left vlt-devide-section">
								<div class="position-relative d-flex align-items-end justify-content-end">

								</div>
							</div>
							<div class="vlt-gap-120"></div>
						</div>
						<div class="col-md-10 offset-md-1">
							<!--Animated block-->
							<div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
								<h5 class="has-white-color">TO BE EFFICIENT: Digital Presence & Visibility:</h5>
							</div>
							<div class="vlt-gap-35"></div>
							<!--Animated block-->
							<div class="vlt-animated-block text-justify" data-aos="fade" data-aos-delay="100">
								<p style="font-size: 20px;">
								The price is largely determined by the<b style="color:#e82e31"> size </b>of the website.
								The <b style="color:#e82e31">number of pages </b>of the website, which can range from 1
								to 200 or more, determines its size. The<b style="color:#e82e31"> style </b>and the
								desired <b style="color:#e82e31">features </b>have an impact on the price as well.
								No matter the style and features you choose, from simple to high-end, the
								most important thing is that the design of the website or web application should
								represent your
								brand while providing an intuitive feel and an excellent user interface.
							</p>
							</div>
							<div class="vlt-gap-60--sm"></div>
						</div>
					</div>
				</div>
				<div class="vlt-gap-50"></div>

				<div class="container">
					<div class="mt-5">
						<!-- Basic plan -->
						<div class="vlt-pricing-card d-style btn btn-brc-tp border-2 bgc-black  w-100 my-2 py-3 shadow-sm">
							<!-- Basic Plan -->
							<div class="row align-items-center">
								<div class="col-12 col-md-4">
									<h4 class="pt-3 text-170 text-600  letter-spacing">
									The One
									</h4>

									<div class="text-secondary-d1 text-120">
										<span class="ml-n15 align-text-bottom">From </span> <span class="text-180"
											style="color: #918f8f;"> 499 €</span>
									</div>
								</div>

								<ul
									class="list-unstyled mb-0 col-12 col-md-4 text-dark-l1 text-90 text-center text-md-left my-4 my-md-0">
									<li>
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Single-Page Landing Design
										</span>
									</li>

									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Mobile & Speed Optimization
										</span>
									</li>
									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Basic SEO & Google Indexing
										</span>
									</li>

									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Contact & Lead Capture Form
										</span>
									</li>
								</ul>

								<div class="col-12 col-md-4 text-center">
									<a href="order"
										class="f-n-hover btn vlt-btn--tertiary btn-raised px-4 py-25 w-75 text-600">Get
										Started</a>
								</div>
							</div>

						</div>

						<!-- standard plan -->
						<div class="vlt-pricing-card d-style bgc-black btn btn-brc-tp w-100 my-2 py-3 shadow-sm border-2">
							<!-- Pro Plan -->
							<div class="row align-items-center">
								<div class="col-12 col-md-4">
									<h4 class="pt-3 text-170 text-600 letter-spacing">
										The Core
									</h4>

									<div class="text-secondary-d2 text-120">
										<span class="align-text-bottom">From </span><span class="text-180"
											style="color: #918f8f;"> 1200 €</span>
									</div>
								</div>

								<ul
									class="list-unstyled mb-0 col-12 col-md-4 text-dark-l1 text-90 text-center text-md-left my-4 my-md-0">
									<li>
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Up to 5 Custom Pages
										</span>
									</li>

									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Full CMS Client Handover
										</span>
									</li>
									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											On-Page SEO Optimization
										</span>
									</li>
									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Interactive Maps & Contact Forms
										</span>
									</li>
									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											30 Days Post-Launch Support
										</span>
									</li>
								</ul>

								<div class="col-12 col-md-4 text-center">
									<a href="order"
										class="f-n-hover btn vlt-btn--tertiary btn-raised px-4 py-25 w-75 text-600">Get
										Started</a>
								</div>
							</div>

						</div>

						<!-- advanced plan -->
						<div class="vlt-pricing-card d-style btn btn-brc-tp border-2 bgc-black w-100 my-2 py-3 shadow-sm">
							<!-- Premium Plan -->
							<div class="row align-items-center">
								<div class="col-12 col-md-4">
									<h4 class="pt-3 text-170 text-600 letter-spacing">
										The Growth
									</h4>

									<div class="text-secondary-d1 text-120">
										<span class="ml-n15 align-text-bottom">From </span><span class="text-180"
											style="color: #918f8f;">2500 €</span>

									</div>
								</div>

								<ul
									class="list-unstyled mb-0 col-12 col-md-4 text-dark-l1 text-90 text-center text-md-left my-4 my-md-0">
									<li>
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Everything in Standard + 3 Revisions
										</span>
									</li>

									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Dynamic CMS Filtering (Blogs/Portfolios)
										</span>
									</li>

									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Technical SEO (Schema & Sitemaps)
										</span>
									</li>
									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											CRM, Email & Booking Integration
										</span>
									</li>
									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Advanced Security & Speed Hardening
										</span>
									</li>
								</ul>

								<div class="col-12 col-md-4 text-center">
									<a href="order"
										class="f-n-hover btn vlt-btn--tertiary btn-raised px-4 py-25 w-75 text-600">Get
										Started</a>
								</div>
							</div>

						</div>

						<!-- all inclusive plan -->
						<div class="vlt-pricing-card d-style btn btn-brc-tp border-2 bgc-black w-100 my-2 py-3 shadow-sm">
							<!-- Premium Plan -->
							<div class="row align-items-center">
								<div class="col-12 col-md-4">
									<h4 class="pt-3 text-170 text-600 letter-spacing">
										The Infinite
									</h4>

									<div class="text-secondary-d1 text-120">
										<span class="ml-n15 align-text-bottom">Based on requirement </span>
									</div>
								</div>

								<ul
									class="list-unstyled mb-0 col-12 col-md-4 text-dark-l1 text-90 text-center text-md-left my-4 my-md-0">
									<li>
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Everything in Premium + Unlimited Pages
										</span>
									</li>

									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Full E-Commerce & Member Portals
										</span>
									</li>

									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Professional Copywriting & Strategy
										</span>
									</li>
									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											Custom Animations & Advanced UI/UX
										</span>
									</li>
									<li class="mt-25">
										<i class="fa fa-check text-success-m2 text-110 mt-1"></i>
										<span class="text-110">
											6 Months Free Website Maintenance
										</span>
									</li>
								</ul>

								<div class="col-12 col-md-4 text-center">
									<a href="order"
										class="f-n-hover btn vlt-btn--tertiary btn-raised px-4 py-25 w-75 text-600">Get
										Started</a>
								</div>
							</div>

						</div>
					</div>
					<div class="col-md-10 offset-md-1">

						<br /><br />
						<p class="text-justify" style="font-size: 20px;">The products that we deliver have a responsive design supporting all devices and stand out
							with their user-centered aspects, interactivity and user-friendly features. <b>Individual
								quotes can be provided to accommodate to your unique needs and requirements.</b></p>

						<div class="vlt-gap-100"></div>
					</div>
				</div>
				<div class="vlt-gap-120"></div>
			</section>


			<!--================== ads package ==================-->
			<section>
				<div class="vlt-gap-120"></div>

				<div class="container">
					<div class="row">
						<div class="col-md-10 offset-md-1">
							<div class="text-center">
								<!--Animated block-->
								<div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
									<!--Section title-->
									<div class="vlt-section-title vlt-section-title--style-1">
										<span class="vlt-section-title__subtitle">Online</span>
										<h2 class="vlt-section-title__title">ADVERTISEMENT SOLUTIONS:</h2>
										<div class="vlt-gap-70"></div>
										<p class="text-justify">Flat rate of<b style="color:#e82e31"> 10% </b> of your
											total monthly advertising
											investment.</p>
										<p class="text-justify">Individual quotes can be provided to accommodate to your
											unique needs and requirements.</p>
									</div>
								</div>
							</div>
							<div class="vlt-gap-70"></div>
						</div>

						<!--================== Business development ==================-->
						<div class="col-md-10 offset-md-1">
							<div class="text-center">
								<!--Animated block-->
								<div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
									<!--Section title-->
									<div class="vlt-section-title vlt-section-title--style-1">
										<!-- <span class="vlt-section-title__subtitle">Send profile</span> -->
										<h2 class="vlt-section-title__title">BUSINESS DEVELOPMENT:</h2>
										<div class="vlt-gap-70"></div>
										<p class="text-justify" style="text-indent: 25px;">The price for this package is
											non fixed and negotiable.
											A few factors, such as the individual customers` needs and requirements and
											the stage that the business is currently in should be considered when
											calculating the price offer. Individual quotes can be provided to
											accommodate to your
											unique needs and requirements.</p>

									</div>
								</div>
							</div>
							<div class="vlt-gap-70"></div>
							<!--Animated block-->

						</div>
					</div>
				</div>
				<div class="vlt-gap-120"></div>
			</section>


			<!--============== Let's work ================-->
			<section class="has-primary-background-color has-white-color">
				<div class="vlt-gap-100"></div>
				<div class="container">
					<div class="text-center">
						<!--Animated block-->
						<div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
							<!--Stroke text-->
							<div class="vlt-stroke-text vlt-stroke-text--lg"><a href="order" target="_self">Let's start</a>
							</div>
						</div>
					</div>
				</div>
				<div class="vlt-gap-100"></div>
			</section>
		</div>
	</main>
</BaseLayout>
