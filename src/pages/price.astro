---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Prices — AH-design"
  htmlClass="no-js vlt-is--careers-single vlt-is--header-fullscreen vlt-is--footer-style-1 vlt-is--footer-fixed"
>
<!--Site overlay-->
	<div class="vlt-site-overlay"></div>
	<!--Main-->
	<main class="vlt-main">
		<!--Page content-->
		<div class="vlt-page-content">
			<div class="vlt-page-title vlt-page-title--style-4">
				<div class="container">
					<div class="row">
						<div class="col-md-7 offset-md-1">
							<h1 class="vlt-page-title__title">We prioritize quality
							</h1>
						</div>
						<div class="col-md-3">
							<div class="vlt-page-title__phantom-title lax" data-lax-translate-x="0 0, vw (vw*0.5)"
								data-lax-opacity="1 1, 250 0" data-lax-anchor=".vlt-page-title">
								Prices
							</div>
						</div>
					</div>
				</div>
			</div>
			<div id="content"></div>


			<!--=========== intro ===========-->
			<section>
				<div class="vlt-gap-100"></div>
				<div class="container">
					<div class="row">
						<div class="col-md-11 offset-md-1">
							<!--Animated block-->
							<div class="vlt-animated-block" data-aos="fade" data-aos-delay="100">
								<p class="fz-3 text-justify">
									We offer different price packages depending on our customers' needs. Several factors such as the size and number of pages of your website, design style, functionality features, scope of automation, and business strategy requirements influence the price across our web design, operational efficiency, and strategic growth packages. No matter what you choose, every solution is tailored to your unique needs — representing your brand, streamlining your operations, and supporting your long-term growth.
								</p>
							</div>

						</div>

						<div class="vlt-gap-120"></div>
						<div class="col-md-11 offset-md-1">
							<!--Animated block-->
							<div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
								<!--Section title-->
								<div class="vlt-section-title vlt-section-title--style-1">
									<h3 class="vlt-section-title__title">Price is what you pay. Value is what you get.
									</h3>

								</div>
							</div>
							<div class="vlt-gap-40--sm"></div>
						</div>
						<div class="col-md-11 offset-md-1">
							<!--Animated block-->
							<div class="vlt-animated-block" data-aos="fade" data-aos-delay="0"><span
									class="vlt-display-1 has-primary-color">— Warren Buffett</span>
							</div>
							<div class="vlt-gap-30"></div>
						</div>
					</div>
				</div>
				<div class="vlt-gap-120"></div>
			</section>


			<!--================ webdesign package ================== -->
			<section
				class="jarallax has-gray-color price-section-bg"
			>
				<div class="container">
					<div class="row">
						<div class="col-md-10 offset-md-1">
							<div class="vlt-stretch-block to-left vlt-devide-section">
								<div class="position-relative d-flex align-items-end justify-content-end">

								</div>
							</div>
							<div class="vlt-gap-120"></div>
						</div>
						</div>
					</div>
					<div class="vlt-gap-50"></div>

					<div class="container">
						<div class="price-tabs">
							<input type="radio" name="price-track" id="price-track-efficient" class="price-track-input" checked />
							<input type="radio" name="price-track" id="price-track-grow" class="price-track-input" />
							<div class="price-tabs-nav">
								<label for="price-track-efficient" class="price-tab-btn">To Be Efficient</label>
								<label for="price-track-grow" class="price-tab-btn">To Grow</label>
							</div>

							<!-- ===== Panel: To Be Efficient ===== -->
							<div class="price-tab-panel" data-track="efficient">
								<div class="row">
									<div class="col-12">
										<h5 class="has-white-color">TO BE SEEN: Digital Presence &amp; Visibility</h5>
										<div class="vlt-gap-35"></div>
										<p class="price-lead text-justify">The price is largely determined by the<b class="price-highlight"> size </b>of your website — the<b class="price-highlight"> number of pages</b>, the<b class="price-highlight"> style</b>, and the desired<b class="price-highlight"> features </b>you choose. No matter the scope, the most important thing is a design that represents your brand while providing an intuitive feel and an excellent user interface.</p>
										<div class="vlt-gap-60--sm"></div>
									</div>
								</div>
								<div class="row">
									<div class="col-12">
										<div class="price-pkg-grid mt-5">

								<!-- The One -->
								<div class="price-pkg-card">
									<div class="price-pkg-num">01</div>
									<div class="price-pkg-name">The One</div>
									<div class="price-pkg-desc">A focused single-page presence to get you online fast.</div>
									<div class="price-pkg-divider"></div>
									<div class="price-pkg-from">Starting from</div>
									<div class="price-pkg-amount">500 €</div>
									<ul class="price-pkg-features">
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Single-Page Landing Design</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Mobile &amp; Speed Optimization</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Basic SEO &amp; Google Indexing</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Contact &amp; Lead Capture Form</li>
									</ul>
									<a href="/order" class="vlt-btn vlt-btn--secondary vlt-btn--lg price-pkg-cta">Get Started</a>
								</div>

								<!-- The Core -->
								<div class="price-pkg-card is-featured">
									<div class="price-pkg-badge">Most Popular</div>
									<div class="price-pkg-num">02</div>
									<div class="price-pkg-name">The Core</div>
									<div class="price-pkg-desc">A complete multi-page site with full CMS handover.</div>
									<div class="price-pkg-divider"></div>
									<div class="price-pkg-from">Starting from</div>
									<div class="price-pkg-amount">1200 €</div>
									<ul class="price-pkg-features">
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Up to 5 Custom Pages</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Full CMS Client Handover</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>On-Page SEO Optimization</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Interactive Maps &amp; Contact Forms</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>30 Days Post-Launch Support</li>
									</ul>
									<a href="/order" class="vlt-btn vlt-btn--tertiary vlt-btn--lg price-pkg-cta">Get Started</a>
								</div>

								<!-- The Growth -->
								<div class="price-pkg-card">
									<div class="price-pkg-num">03</div>
									<div class="price-pkg-name">The Growth</div>
									<div class="price-pkg-desc">A scalable site with dynamic content and integrations.</div>
									<div class="price-pkg-divider"></div>
									<div class="price-pkg-from">Starting from</div>
									<div class="price-pkg-amount">2500 €</div>
									<ul class="price-pkg-features">
										<li class="price-pkg-includes">Everything in The Core, plus:</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>3 Design Revisions</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Dynamic CMS Filtering (Blogs/Portfolios)</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Technical SEO (Schema &amp; Sitemaps)</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>CRM, Email &amp; Booking Integration</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Advanced Security &amp; Speed Hardening</li>
									</ul>
									<a href="/order" class="vlt-btn vlt-btn--secondary vlt-btn--lg price-pkg-cta">Get Started</a>
								</div>

								<!-- The Infinite -->
								<div class="price-pkg-card">
									<div class="price-pkg-num">04</div>
									<div class="price-pkg-name">The Infinite</div>
									<div class="price-pkg-desc">A bespoke platform with e-commerce and ongoing support.</div>
									<div class="price-pkg-divider"></div>
									<div class="price-pkg-custom">Custom Pricing</div>
									<ul class="price-pkg-features">
										<li class="price-pkg-includes">Everything in The Growth, plus:</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Unlimited Pages</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Full E-Commerce &amp; Member Portals</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Professional Copywriting &amp; Strategy</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Custom Animations &amp; Advanced UI/UX</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>6 Months Free Website Maintenance</li>
									</ul>
									<a href="/order" class="vlt-btn vlt-btn--secondary vlt-btn--lg price-pkg-cta">Let's Talk</a>
								</div>

										</div>
									</div>
								</div>
								<div class="row">
									<div class="col-12">
										<div class="vlt-gap-50"></div>
										<p class="text-justify price-lead">The products that we deliver have a responsive design supporting all devices and stand out with their user-centered aspects, interactivity and user-friendly features. <b>Individual quotes can be provided to accommodate to your unique needs and requirements.</b></p>
										<div class="vlt-gap-100"></div>
									</div>
								</div>
							</div>

							<!-- ===== Panel: To Grow ===== -->
							<div class="price-tab-panel" data-track="grow">
								<div class="row">
									<div class="col-12">
										<h5 class="has-white-color">TO GROW: Business scaling</h5>
										<div class="vlt-gap-35"></div>
										<p class="price-lead text-justify">For established businesses seeking high-level consulting, infrastructure planning, and long-term market expansion. The investment scales with the depth of strategy and the systems we build together. <b>Individual quotes can be provided to accommodate to your unique needs and requirements.</b></p>
										<div class="vlt-gap-60--sm"></div>
									</div>
								</div>
								<div class="row">
									<div class="col-12">
										<div class="price-pkg-grid mt-5">

								<!-- Growth Foundation -->
								<div class="price-pkg-card">
									<div class="price-pkg-num">01</div>
									<div class="price-pkg-name">Starter Visibility</div>
									<div class="price-pkg-desc">Get found, get noticed, and start winning.</div>
									<div class="price-pkg-divider"></div>
									<div class="price-pkg-from">Starting from</div>
									<div class="price-pkg-amount">150 €/month</div>
									<ul class="price-pkg-features">
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Single page website design</li>
											<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Google Business Profile optimization</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Review growth system setup</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Social media setup</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Basic SEO improvements</li>
											<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Monthly performance report</li>
									</ul>
									<a href="/order" class="vlt-btn vlt-btn--secondary vlt-btn--lg price-pkg-cta">Get Started</a>
								</div>

								<!-- Growth Infrastructure -->
								<div class="price-pkg-card is-featured">
									<div class="price-pkg-badge">Most Popular</div>
									<div class="price-pkg-num">02</div>
									<div class="price-pkg-name">Digital Authority</div>
									<div class="price-pkg-desc">Establish credibility and convert visitors into loyal clients.</div>
									<div class="price-pkg-divider"></div>
									<div class="price-pkg-from">Starting from</div>
									<div class="price-pkg-amount">300 €/month</div>
									<ul class="price-pkg-features">
										<li class="price-pkg-includes">Everything in "Starter Visibility" plus:</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Professional website design</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Integrated online booking system</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Mobile optimization</li>
											<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Custom contact forms</li>
											<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Analytics dashboard</li>
									</ul>
									<a href="/order" class="vlt-btn vlt-btn--tertiary vlt-btn--lg price-pkg-cta">Get Started</a>
								</div>

								<!-- Strategic Expansion -->
								<div class="price-pkg-card">
									<div class="price-pkg-num">03</div>
									<div class="price-pkg-name">Scale &amp; Automate</div>
									<div class="price-pkg-desc">Eliminate manual tasks and fuel rapid expansion.</div>
									<div class="price-pkg-divider"></div>
									<div class="price-pkg-from">Starting from</div>
									<div class="price-pkg-amount">500 €/month</div>
									<ul class="price-pkg-features">
										<li class="price-pkg-includes">Everything in "Digital Authority" plus:</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>AI assistant integration</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Smart follow-ups</li>
											<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Centralized customer database</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Marketing automation &amp; lead tracking</li>
											<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Monthly strategy session</li>
									</ul>
									<a href="/order" class="vlt-btn vlt-btn--secondary vlt-btn--lg price-pkg-cta">Get Started</a>
								</div>

								<!-- Strategic Partnership -->
								<div class="price-pkg-card">
									<div class="price-pkg-num">04</div>
									<div class="price-pkg-name">The Growth Engine</div>
									<div class="price-pkg-desc">Your dedicated partner for end-to-end success.</div>
									<div class="price-pkg-divider"></div>
									<div class="price-pkg-custom">Custom Pricing</div>
									<ul class="price-pkg-features">
										<li class="price-pkg-includes">Everything included, plus:</li>
											<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Custom development &amp; advanced automations</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Strategic growth consulting</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Dedicated priority support</li>
										<li class="price-pkg-feature"><span class="price-pkg-check"><svg viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Continuous custom system development</li>
									</ul>
									<a href="/order" class="vlt-btn vlt-btn--secondary vlt-btn--lg price-pkg-cta">Let's Talk</a>
								</div>

										</div>
									</div>
								</div>
								<div class="row">
									<div class="col-12">
										<div class="vlt-gap-100"></div>
									</div>
								</div>
							</div>

						</div>
					</div>
				<div class="vlt-gap-120"></div>
			</section>


			<!--================== ads package ==================-->
			<section>
				<div class="vlt-gap-120"></div>

				<div class="container">
					<div class="row">
						<div class="col-md-10 offset-md-1">
							<div class="text-center">
								<!--Animated block-->
								<div class="vlt-animated-block" data-aos="fade" data-aos-delay="0">
									<!--Section title-->
									<div class="vlt-section-title vlt-section-title--style-1">
										<span class="vlt-section-title__subtitle">Online</span>
										<h2 class="vlt-section-title__title">ADVERTISEMENT SOLUTIONS:</h2>
										<div class="vlt-gap-70"></div>
										<p class="text-justify">Flat rate of <b class="has-primary-color">10%</b> of your
											total monthly advertising
											investment. Individual quotes can be provided to accommodate to your
											unique needs and requirements.</p>
											<div class="vlt-gap-40"></div>
											<!--Simple link--><a class="vlt-simple-link vlt-simple-link--md"
