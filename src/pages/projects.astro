<style is:global>
  /* Keep the outlined "Projects" word fully inside the viewport */
  .vlt-page-title--style-4 .vlt-page-title__phantom-title {
    font-size: clamp(56px, 6.1vw, 88px);
  }

  /* Bento grid: 3 cols; featured 2x2 + 2 stacked, then 3 small; featured alternates sides */
  .ah-projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    --ah-header-h: 102px;
    --ah-grid-gap: 30px;
    --ah-block-pad: 24px;
    /* one block (2 rows + gap) = exactly the viewport below the fixed header */
    grid-auto-rows: max(
      calc((100svh - var(--ah-header-h) - var(--ah-grid-gap) - 2 * var(--ah-block-pad)) / 2),
      280px
    );
    grid-auto-flow: dense;
    gap: var(--ah-grid-gap);
  }
  .ah-projects-item:nth-child(6n + 1):not(:last-child) {
    scroll-margin-top: calc(var(--ah-header-h) + var(--ah-block-pad));
  }
  .ah-projects-item {
    min-width: 0;
    min-height: 0;
  }
  .ah-projects-item:nth-child(12n + 1):not(:last-child) {
    grid-column: 1 / span 2;
    grid-row: span 2;
  }
  .ah-projects-item:nth-child(12n + 2),
  .ah-projects-item:nth-child(12n + 3) {
    grid-column: 3;
  }
  .ah-projects-item:nth-child(12n + 7) {
    grid-column: 2 / span 2;
    grid-row: span 2;
  }
  .ah-projects-item:nth-child(12n + 8),
  .ah-projects-item:nth-child(12n + 9) {
    grid-column: 1;
  }

  /* Small card: frosted glass */
  .ah-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 30px 20px 0;
    overflow: hidden;
    border-radius: 30px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(32, 31, 66, 0.72);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    color: #fff;
  }
  .ah-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .ah-card__title {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
    color: #fff;
  }
  .ah-card__arrow {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin: -6px -6px 0 0;
    border-radius: 50%;
    background: #fff;
    color: #201f42;
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
  }
  .ah-card__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 0;
    font-weight: 300;
    opacity: 0.75;
  }
  .ah-card__shots {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    margin-top: 20px;
  }
  /* no hover zoom: it crops the screenshot's own navigation */
  .ah-card:hover .vlt-work__media img {
    transform: none;
  }
  .ah-card__desktop {
    position: absolute;
    inset: 0 0 0 0;
    overflow: hidden;
    border-radius: 14px 14px 0 0;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  }
  .ah-card__mobile {
    position: absolute;
    left: -8px;
    bottom: 0;
    width: 28%;
    height: 72%;
    overflow: hidden;
    border: 3px solid rgba(255, 255, 255, 0.9);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
  }
  .ah-card__mobile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .ah-card__desktop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    cursor: zoom-in;
  }

  /* Featured card: full-bleed image, overlay title, round arrow button */
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card {
    padding: 0;
    border: 0;
    background: #201f42;
  }
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__shots {
    position: absolute;
    inset: 0;
    margin: 0;
  }
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__desktop {
    border-radius: 0;
    box-shadow: none;
  }
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__mobile {
    display: none;
  }
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__shots::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 220px;
    pointer-events: none;
    background: linear-gradient(to top, rgba(32, 31, 66, 0.9) 0%, rgba(32, 31, 66, 0) 100%);
  }
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__head {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 70px;
    z-index: 2;
    pointer-events: none;
  }
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__title,
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__type {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.55);
  }
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__title {
    font-size: 48px;
  }
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__meta {
    position: absolute;
    left: 40px;
    bottom: 32px;
    z-index: 2;
    margin: 0;
  }
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__arrow {
    position: absolute;
    top: -9999px;
  }
  .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card::after {
    content: '\2197';
    position: absolute;
    top: 30px;
    right: 30px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #fff;
    color: #201f42;
    font-size: 28px;
  }

  /* Featured card: title + overlay appear only on hover (devices with hover) */
  @media (hover: hover) {
    .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__head,
    .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__meta,
    .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__shots::after {
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card:hover .ah-card__head,
    .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card:hover .ah-card__meta,
    .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card:hover .ah-card__shots::after {
      opacity: 1;
    }
  }

  @media (max-width: 991px) {
    .ah-projects-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 400px;
    }
    .ah-projects-item:nth-child(n) {
      grid-column: auto;
      grid-row: auto;
    }
    .ah-projects-item:nth-child(6n + 1):not(:last-child) {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 575px) {
    .ah-projects-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 380px;
    }
    .ah-projects-item:nth-child(6n + 1):not(:last-child) {
      grid-column: auto;
    }
    .ah-projects-item:nth-child(6n + 1):not(:last-child) .ah-card__title {
      font-size: 32px;
    }
  }

  .vlt-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    background: rgba(0, 0, 0, 0.9);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }
  .vlt-lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }
  .vlt-lightbox__img {
    max-width: 92vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    transform: scale(0.96);
    transition: transform 0.25s ease;
  }
  .vlt-lightbox.is-open .vlt-lightbox__img {
    transform: scale(1);
  }
  .vlt-lightbox__close {
    position: absolute;
    top: 24px;
    right: 32px;
    width: 48px;
    height: 48px;
    border: none;
    background: transparent;
    color: #fff;
    font-size: 40px;
    line-height: 1;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  .vlt-lightbox__close:hover {
    opacity: 1;
  }
</style>

<script>
  function initLightbox() {
    const lightbox = document.getElementById('vlt-lightbox');
    if (!lightbox) return;
    const lightboxImg = lightbox.querySelector('.vlt-lightbox__img');
    const closeBtn = lightbox.querySelector('.vlt-lightbox__close');

    function open(src, alt) {
      lightboxImg.setAttribute('src', src);
      lightboxImg.setAttribute('alt', alt || '');
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.vlt-work__media').forEach((media) => {
      media.addEventListener('click', (e) => {
        const img = media.querySelector('img');
        if (!img) return;
        e.preventDefault();
        open(img.getAttribute('src'), img.getAttribute('alt'));
      });
    });

    closeBtn.addEventListener('click', close);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox.classList.contains('is-open')) close();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLightbox);
  } else {
    initLightbox();
  }
</script>
