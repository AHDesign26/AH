---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../lib/seo';
---

<BaseLayout
  title="Projects & Portfolio | AH Design"
  description="A selection of websites, online stores and brand work delivered by AH Design for clients across a range of industries."
  schema={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Projects', path: '/projects' },
    ]),
  ]}
  htmlClass="no-js vlt-is--work-masonry-4-col vlt-is--header-fullscreen vlt-is--footer-style-1 vlt-is--footer-fixed"
>
  <!--Site overlay-->
  <div class="vlt-site-overlay"></div>
  <!--Main-->
  <main class="vlt-main">
    <!--Page content-->
    <div class="vlt-page-content">
      <div class="vlt-page-title vlt-page-title--style-4">
        <div class="container">
          <div class="row">
            <div class="col-md-7 offset-md-1">
              <h1 class="vlt-page-title__title">We Display With Pride</h1>
            </div>
            <div class="col-md-3">
              <div
                class="vlt-page-title__phantom-title lax"
                data-lax-translate-x="0
									0, vw (vw*0.5)"
                data-lax-opacity="1 1, 250 0"
                data-lax-anchor=".vlt-page-title"
              >
                Projects
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="content"></div>
