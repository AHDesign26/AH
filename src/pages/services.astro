---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services — AH-design"
  htmlClass="no-js vlt-is--services-01 vlt-is--header-fullscreen vlt-is--footer-style-1 vlt-is--footer-fixed"
>
<!-- ============= Site overlay ============== -->
	<div class="vlt-site-overlay"></div>
	<!--Main-->
	<main class="vlt-main">
		<!--Page content-->
		<div class="vlt-page-content">
			<!--====== Page title ======-->
			<div class="vlt-page-title vlt-page-title--style-4">
				<div class="container">
					<div class="row">
						<div class="col-md-6 offset-md-1">
							<h1 class="vlt-page-title__title">We build modern experiences
							</h1>
						</div>
						<div class="col-md-4">
							<div class="vlt-page-title__phantom-title lax" data-lax-translate-x="0 0,
								vw (vw*0.5)"
								data-lax-opacity="1 1, 250 0" data-lax-anchor=".vlt-page-title">
								Services
							</div>
						</div>
					</div>
					<div class="vlt-gap-120"></div>
					<div class="row">
						<div class="col-md-1"></div>
						<div class="col-md-10">
							<p class="text-justify">
								We are professional and creative in our approach, providing both generic and tailored digital solutions. Whether you need a ready-to-launch website, a fully customized marketing strategy, or a systemized business growth plan, our products stand out with their user-centered aspects, interactivity, and user-friendly features. Highly satisfied customers and improved business performance are some of the key outcomes we can assist you in achieving. Beyond providing top-quality web solutions, we are experienced in digital advertising and systemized business development.
							</p>
						</div>
						<div class="col-md-1"></div>
					</div>

				</div>
			</div>
			<div id="content"></div>


			<!--========================== services ==========================-->
			<section class="position-relative">
				<div class="vlt-gap-120"></div>
				<div class="vlt-gap-120"></div>
				<div class="container">
					<div class="row">
						<div class="col-md-5" style="background-color: black;">
							<div class="position-relative">
								<!--Particle image-->
								<img class="vlt-particle service-img" src="/static/img/service-image-04.png"
									data-animation-name="fadeInUp" alt="" loading="lazy">
								<!--Simple image-->
								<div class="vlt-simple-image">
									<div class="vlt-simple-image__mask" data-aos="image-mask-animation"
										data-aos-delay="0">
										<div class="inside"></div>
									</div>
									<video class="fade-edges" width="100%" height="100%" autoplay muted loop
										style="margin-top:150px">
										<source src="/static/img/services/wd.mp4" type="video/mp4">
										Your browser does not support the video tag.
									</video>
								</div>
							</div>
							<div class="vlt-gap-60--sm"></div>
						</div>
						<div class="col-md-5 offset-md-2">
							<!--Animated block-->
							<div class="vlt-animated-block service-tt" data-aos="fade"
								data-aos-delay="100">
								<span class="has-primary-color" style="display:block; font-size:13px; font-weight:700; letter-spacing:2px; margin-bottom:12px; text-transform:uppercase;">To Be Efficient</span>
								<h2>Website Design & Development</h2>
								<div class="vlt-gap-40"></div>
								<p>
								Your website should work as hard as you do. We craft beautiful, fully responsive, and highly interactive websites that adapt to all devices. By prioritizing user-centered design and intuitive functionality, we streamline your digital user experience—turning casual visitors into loyal, paying clients.
								</p>
								<div class="vlt-gap-40"></div>
								<div class="has-black-color">
									<!--Styled list-->
									<ul class="vlt-styled-list vlt-styled-list--style-3">
										<li>Websites & E-Commerce Applications
										</li>
										<li>Custom Web Applications
										</li>
										<li>Content Management Systems (CMS)
										</li>
										<li>QUALITY ASSURANCE AND TESTING
										</li>
										
						
									</ul>
								</div>
								<div class="vlt-gap-50"></div>
								<!--Button--><a class="vlt-btn vlt-btn--secondary vlt-btn--md" href="/web_development" target="_self">learn more</a>
							</div>
						</div>
					</div>
				</div>
				<div class="vlt-gap-120"></div>
				<div class="vlt-gap-120"></div>
				<div class="container">
					<div class="row">
						<div class="col-md-5 offset-md-2 order-md-5" style="background-color:
							black;">
							<div class="position-relative">
								<!--Particle image-->

								<img class="vlt-particle service-img" src="/static/img/service-image-05.png"
									data-animation-name="fadeInUp" alt="" loading="lazy">
								<!--Simple image-->
								<div class="vlt-simple-image">
									<div class="vlt-simple-image__mask" data-aos="image-mask-animation"
										data-aos-delay="0">
										<div class="inside"></div>
									</div>
									<video width="100%" height="100%" autoplay muted loop
										style="margin-top:150px">

										<source src="/static/img/services/digital_marketing.mp4" type="video/mp4">
										<!-- <source src="movie.ogg" type="video/ogg"> -->
										Your browser does not support the video tag.
									</video>
								</div>
							</div>
							<div class="vlt-gap-60--sm"></div>
						</div>
						<div class="col-md-5">
							<!--Animated block-->
							<div class="vlt-animated-block service-tt" data-aos="fade"
								data-aos-delay="100">
								<span class="has-primary-color" style="display:block; font-size:13px; font-weight:700; letter-spacing:2px; margin-bottom:12px; text-transform:uppercase;">To Be Seen</span>
								<h2>Digital Marketing</h2>
								<div class="vlt-gap-40"></div>
								<p>
								Get your business in front of the right audience at the perfect time. We drive high-quality, targeted traffic to your brand using advanced SEO techniques, strategic pay-per-click (PPC) advertising, and data-driven contextual marketing campaigns engineered to dominate search results and maximize your online visibility.
								</p>
								<div class="vlt-gap-40"></div>
								<div class="has-black-color">
									<!--Styled list-->
									<!--
									<ul class="vlt-styled-list vlt-styled-list--style-3">
										<li>SEO (Search engine optimization).
										</li>
										<li>PPC, google my business.
										</li>
										<li>Google Ads
										</li>
										<li>Social Media Marketing
										</li>
										<li>YouTube ads
										</li>
									</ul>
									-->

								</div>
								<div class="vlt-gap-50"></div>
								<!--Button--><a class="vlt-btn vlt-btn--secondary vlt-btn--md"
									href="/ads-service" target="_self">learn more</a>
							</div>
						</div>
					</div>
				</div>
				<div class="vlt-gap-120"></div>
				<div class="vlt-gap-120"></div>
				<div class="container">
					<div class="row">
						<div class="col-md-5" style="background-color: black;">
							<div class="position-relative">
								<!--Particle image-->
								<img class="vlt-particle service-img" src="/static/img/service-image-06.png"
									data-animation-name="fadeInUp" alt="" loading="lazy">
								<!--Simple image-->
								<div class="vlt-simple-image">
									<div class="vlt-simple-image__mask" data-aos="image-mask-animation"
										data-aos-delay="0">
										<div class="inside"></div>
									</div>
									<video width="100%" height="100%" autoplay muted loop
										style="margin-top:150px">
										<source src="/static/img/services/business_scaling.mp4" type="video/mp4">
										<!-- <source src="movie.ogg" type="video/ogg"> -->
										Your browser does not support the video tag.
									</video>
								</div>
							</div>
							<div class="vlt-gap-60--sm"></div>
						</div>
						<div class="col-md-5 offset-md-2">
							<!--Animated block-->
							<div class="vlt-animated-block service-tt" data-aos="fade"
								data-aos-delay="100">
								<span class="has-primary-color" style="display:block; font-size:13px; font-weight:700; letter-spacing:2px; margin-bottom:12px; text-transform:uppercase;">To Grow</span>
								<h2>Business scaling</h2>
								<div class="vlt-gap-40"></div>
								<p>
								Scale your business with predictable, robust systems. We design and implement advanced lead generation funnels, automated customer acquisition activities, and long-term business development strategies explicitly tailored to expand your market share, optimize operational efficiency, and accelerate your overall revenue growth.
								</p>
								<div class="vlt-gap-40"></div>
								<div class="has-black-color">
									<!--Styled list-->
									<ul class="vlt-styled-list vlt-styled-list--style-3">
										<li>Brand Strategy & Business Planning
										</li>
										<li>Local SEO & Platform Citations (Google, Facebook, Instagram)
										</li>
										<li>Workflow & Business Automation
										</li>

									</ul>
								</div>
								<div class="vlt-gap-50"></div>
								<!--Button--><a class="vlt-btn vlt-btn--secondary vlt-btn--md"
									href="/fricta" target="_self">learn more</a>
							</div>
						</div>
					</div>
				</div>
				<div class="vlt-gap-120"></div>
			</section>


			<!--===================== Testimonial ======================-->

		</div>
	</main>

	<style>
		/* Feather the wd.mp4 video edges so it blends into the surrounding
		   black panel instead of showing a hard rectangular border. The
		   radial mask keeps the center fully opaque and fades to transparent
		   near the edges. */
		.fade-edges {
			-webkit-mask-image: radial-gradient(
				ellipse 85% 85% at center,
				black 55%,
				transparent 100%
			);
			mask-image: radial-gradient(
				ellipse 85% 85% at center,
				black 55%,
				transparent 100%
			);
		}
	</style>
</BaseLayout>
